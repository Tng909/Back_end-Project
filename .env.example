PORT=3000
MONGO_URI=mongodb://localhost:27017/musicdb
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
APP_NAME=Online Music
ADMIN_EMAIL=admin@example.com
# Password for the seeded admin account (fallback exists for dev only — set it here).
ADMIN_PASSWORD=change-this-admin-password
# --- Optional sender mailbox (nodemailer, best-effort — register/login work even if unset/wrong) ---
# Gmail: 2-Step Verification ON > App passwords > 16-char code > paste below (NOT your login password).
MAIL_PROVIDER=gmail
MAIL_USER=your-full-address@gmail.com
MAIL_PASS=your-16-character-Google-App-Password
MAIL_FROM=your-full-address@gmail.com
EMAIL_USER=your-real-address@gmail.com
EMAIL_PASS=your-real-google-app-password
# MAIL_*, SMTP_*, and EMAIL_USER / EMAIL_PASS aliases are supported.
# Gmail configuration above is equivalent to the supplied Nodemailer service:'gmail' setup.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourmail.com
SMTP_PASS=yourpassword
# --- Custom SMTP provider (your case) ---
# Replace with values from YOUR provider's dashboard (e.g. Hostinger/Brevo/SendGrid/cPanel).
# Must be a real DNS host — placeholders like "the-provider's-SMTP-host" never resolve (ENOTFOUND)
# and are now treated as "not configured" (register/login still work, no email sent).
# Example:
# MAIL_PROVIDER=custom
# MAIL_HOST=mail.yourdomain.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=you@yourdomain.com
# MAIL_PASS=<smtp-password-or-api-key-from-provider>
# MAIL_FROM=you@yourdomain.com
# --- Security hardening (server.js) ---
# Extra browser origins allowed to call the API (comma-separated). The app's own
# APP_URL + http://localhost:3000 are always allowed. curl / mobile apps (no
# Origin header) are always allowed.
CORS_ORIGIN=
# Rate limits per IP per 15 minutes (defaults: 300 general, 50 on /api/auth).
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=50
# --- Performance / scaling (server.js + services/cache.js) ---
# Redis connection (Render Key Value supplies this automatically via render.yaml).
# Leave empty to fall back to the in-memory cache (fine for dev / single instance).
REDIS_URL=
# Response-cache TTL in seconds for hot public GETs (default 60).
CACHE_TTL_SECONDS=60
# Optional CDN origin for /uploads (e.g. https://cdn.yourdomain.com).
# When set, /uploads URLs are redirected there; leave empty to serve locally.
CDN_BASE_URL=
# Mongo driver pool size per instance (default 20).
MONGO_MAX_POOL_SIZE=20
# --- AI chat (Boxie popup messenger) ---
# Get a free key: https://aistudio.google.com/app/apikey
# Leave empty to use the built-in local brain (no key needed).
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash