PORT=3000
MONGO_URI=mongodb://localhost:27017/musicdb
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
APP_NAME=Online Music
ADMIN_EMAIL=admin@example.com
# --- Optional sender mailbox (nodemailer, best-effort — register/login work even if unset/wrong) ---
# Gmail: 2-Step Verification ON > App passwords > 16-char code > paste below (NOT your login password).
MAIL_PROVIDER=gmail
MAIL_USER=your-full-address@gmail.com
MAIL_PASS=your-16-character-Google-App-Password
MAIL_FROM=your-full-address@gmail.com
EMAIL_USER=your-real-address@gmail.com
EMAIL_PASS=your-real-google-app-password
# MAIL_*, SMTP_*, and EMAIL_USER / EMAIL_PASS aliases are supported.
# Gmail configuration above is equivalent to the supplied Nodemailer service:'gmail' setup.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourmail.com
SMTP_PASS=yourpassword
# --- Custom SMTP provider (your case) ---
# Replace with values from YOUR provider's dashboard (e.g. Hostinger/Brevo/SendGrid/cPanel).
# Must be a real DNS host — placeholders like "the-provider's-SMTP-host" never resolve (ENOTFOUND)
# and are now treated as "not configured" (register/login still work, no email sent).
# Example:
# MAIL_PROVIDER=custom
# MAIL_HOST=mail.yourdomain.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=you@yourdomain.com
# MAIL_PASS=<smtp-password-or-api-key-from-provider>
# MAIL_FROM=you@yourdomain.com