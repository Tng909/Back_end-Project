PORT=3000
MONGO_URI=mongodb://localhost:27017/musicdb
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
APP_NAME=Online Music
# --- Optional sender mailbox (nodemailer, best-effort — register/login work even if unset/wrong) ---
# Gmail: 2-Step Verification ON > App passwords > 16-char code > paste below (NOT your login password).
MAIL_PROVIDER=gmail
MAIL_USER=you@gmail.com
MAIL_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM=you@gmail.com
# (SMTP_* aliases also work: SMTP_USER / SMTP_PASS / SMTP_HOST / SMTP_PORT / SMTP_SECURE)