# Dependencies
node_modules/
# NOTE: package-lock.json MUST be committed (reproducible installs).

# Env / secrets
.env
.env.local
.env.*.local

# Uploads (user content, regenerated at runtime)
uploads/audio/*
uploads/covers/*
uploads/avatars/*
!uploads/audio/.gitkeep
!uploads/covers/.gitkeep
!uploads/avatars/.gitkeep

# RSA private key for RS256 JWT signing — NEVER commit
config/jwtPrivate.pem

# Logs / OS
*.log
.DS_Store
Thumbs.db

# Media binaries (large, keep out of repo — document in README instead)
main/record/*.mp3